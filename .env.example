# Copy to .env.local (never commit .env.local). Set the same values in Vercel.

# Organiser-issued key. Server side only: never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Model names the key can call. Find them with: npm run check:models
OPENAI_VISION_MODEL=
OPENAI_TTS_MODEL=

# Optional. Voice for read-aloud; empty means "coral", which every speech model accepts.
# marin or cedar sound better but need a gpt-4o-mini-tts class model, not tts-1.
OPENAI_TTS_VOICE=

# Dev only: 1 makes the app answer from src/fixtures instead of calling the API.
# Leave empty in Vercel. The demo must run on real AI.
NEXT_PUBLIC_USE_MOCKS=
